{
  "name": "@orderflow/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../../packages/shared run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretypecheck": "npm --prefix ../../packages/shared run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orderflow/shared": "0.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
