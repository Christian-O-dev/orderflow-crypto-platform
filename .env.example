PORT=4000
MARKET_DATA_MODE=real

# PostgreSQL local from docker-compose.yml
DATABASE_URL=postgres://orderflow:orderflow@localhost:5432/orderflow

# Optional alert thresholds
LARGE_TRADE_THRESHOLD=1
LARGE_TRADE_MEDIUM_USD=100000
LARGE_TRADE_HIGH_USD=500000
LARGE_TRADE_WHALE_USD=1000000
WHALE_ORDER_THRESHOLD_USD=1000000
CVD_SPIKE_THRESHOLD=5
CVD_SPIKE_WINDOW_MS=5000
LIQUIDITY_WALL_THRESHOLD=8

# Optional performance and connection tuning
SNAPSHOT_INTERVAL_MS=250
PERSISTENCE_INTERVAL_MS=1000
FALLBACK_AFTER_MS=5000
WHALE_ORDERS_EMIT_INTERVAL_MS=1000
MARKET_STATS_LOG_INTERVAL_MS=30000
ALERT_COOLDOWN_MS=5000
LIQUIDITY_REMOVED_RATIO=0.65
RECENT_LARGE_TRADE_IDS=500
MAX_TRACKED_WHALE_LEVELS=100
MAX_WHALE_ORDERS_TO_CLIENT=100
BINANCE_RECONNECT_DELAY_MS=2500
BINANCE_DEEP_RESYNC_DELAY_MS=1000
BINANCE_SNAPSHOT_TIMEOUT_MS=5000
BINANCE_MAX_BUFFERED_DEPTH_EVENTS=1000
BINANCE_TOP_LEVELS=20
BINANCE_MAX_DEEP_LEVELS=1000
BINANCE_DEPTH_FALLBACK_LEVELS=20
